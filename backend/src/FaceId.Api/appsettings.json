{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": false,
    "EvidenceBucket": "faceid-security-evidence",
    "ExportsBucket": "faceid-exports",
    "ComplianceBucket": "faceid-compliance"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "faceid",
    "Audience": "faceid-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "PasswordHashing": {
    "Iterations": 3,
    "MemoryKb": 65536,
    "DegreeOfParallelism": 2,
    "SaltBytes": 16,
    "HashBytes": 32
  }
}
