{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": false,
    "EvidenceBucket": "faceid-security-evidence",
    "ExportsBucket": "faceid-exports",
    "ComplianceBucket": "faceid-compliance"
  },
  "AllowedHosts": "*"
}
