{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": false,
    "EvidenceBucket": "faceid-security-evidence",
    "ExportsBucket": "faceid-exports",
    "ComplianceBucket": "faceid-compliance"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "faceid",
    "Audience": "faceid-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "PasswordHashing": {
    "Iterations": 3,
    "MemoryKb": 65536,
    "DegreeOfParallelism": 2,
    "SaltBytes": 16,
    "HashBytes": 32
  },
  "Messaging": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "Username": "faceid",
    "Password": "",
    "VirtualHost": "/",
    "Topology": {
      "AuditExchange": "faceid.audit",
      "AuditQueue": "faceid.audit",
      "RealTimeExchange": "faceid.realtime",
      "RealTimeQueuePrefix": "faceid.realtime"
    }
  },
  "RealTime": {
    "ObserverBufferSize": 32,
    "HeartbeatSeconds": 20,
    "ReconnectionMilliseconds": 3000
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "LoginPerMinute": 10,
    "CompanyRegistrationPerHour": 3,
    "CnpjLookupPerMinute": 10,
    "ExportPerHour": 10
  },
  "BrasilApi": {
    "BaseUrl": "https://brasilapi.com.br/api/",
    "TimeoutSeconds": 5
  }
}
