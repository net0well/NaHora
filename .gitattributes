# Normalize line endings so a checkout on Windows, Linux or macOS produces the
# same content. Without this, the CI diff is full of whole-file changes.
* text=auto eol=lf

# Windows-only tooling that breaks with LF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf

# Binary — never diffed, never converted
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.onnx      binary
*.pfx       binary
*.p12       binary
*.zip       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# AFD is a fixed-layout ASCII file whose records end in CR+LF by regulation.
# Git must not touch it.
*.afd       binary
*.p7s       binary

# Generated files — collapse in pull request diffs
pubspec.lock        linguist-generated=true
**/generated_plugin_registrant.cc  linguist-generated=true
**/generated_plugin_registrant.h   linguist-generated=true
**/generated_plugins.cmake         linguist-generated=true
