# -----------------------------------------------------------------------------
# FaceId — variáveis de ambiente
#
# Copie para .env e ajuste. O .env real NUNCA entra no Git.
#   cp .env.example .env
#
# As senhas da infraestrutura local sao dev-only e batem com
# appsettings.Development.json — os servicos so escutam em localhost.
# Os segredos marcados CHANGE_ME nao tem default seguro possivel: a aplicacao
# recusa iniciar em producao enquanto estiverem no valor de exemplo.
# -----------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=faceid
POSTGRES_USER=faceid
POSTGRES_PASSWORD=faceid_dev_only
POSTGRES_PORT=5432

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=faceid_dev
MINIO_ROOT_PASSWORD=faceid_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=faceid
RABBITMQ_PASSWORD=faceid_dev_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Observabilidade ---------------------------------------------------------
# Aspire Dashboard: recebe OTLP e mostra traces, métricas e logs.
# Interface em http://localhost:18888
ASPIRE_DASHBOARD_PORT=18888
OTLP_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Mensageria --------------------------------------------------------------
Messaging__Enabled=true
Messaging__Host=localhost
Messaging__Username=faceid
Messaging__Password=faceid_dev_only
Messaging__Exchange=faceid.events

# --- Mailpit (SMTP de desenvolvimento) ---------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Backend — sobrepõem appsettings.json. O duplo sublinhado separa a seção.
# -----------------------------------------------------------------------------

Database__ConnectionString=Host=localhost;Port=5432;Database=faceid;Username=faceid;Password=faceid_dev_only
Database__AutoMigrate=true

Storage__Endpoint=localhost:9000
Storage__AccessKey=faceid_dev
Storage__SecretKey=faceid_dev_secret
Storage__UseSsl=false

# --- Autenticação ------------------------------------------------------------
# Mínimo de 32 bytes. Gere com:
#   openssl rand -base64 48
Jwt__Issuer=faceid
Jwt__Audience=faceid-app
Jwt__SigningKey=CHANGE_ME_generate_at_least_32_bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- Biometria ---------------------------------------------------------------
# Caminho dos modelos ONNX. Ver models/README.md para origem, licença e hash.
Biometrics__ModelsPath=./models

# Valores iniciais, a serem calibrados experimentalmente antes de produção.
Biometrics__Thresholds__Similarity=0.38
Biometrics__Thresholds__SimilarityReview=0.30
Biometrics__Thresholds__Liveness=0.70
Biometrics__Thresholds__LivenessReview=0.55
Biometrics__Thresholds__Quality=0.60

# Chave AES-256 para cifrar embeddings em repouso. Biometria vazada não pode ser
# trocada como uma senha — trate esta chave como o segredo mais crítico do sistema.
Biometrics__EmbeddingEncryptionKey=CHANGE_ME_generate_32_bytes_base64

# --- Conformidade (Portaria 671/2021) ----------------------------------------
# Certificado e-CNPJ A1 para assinar o AFD. Em desenvolvimento use o
# auto-assinado gerado por scripts/generate-dev-cert.ps1.
Compliance__Certificate__Path=./certs/faceid-dev.pfx
Compliance__Certificate__Password=faceid_dev_only
Compliance__Certificate__IsProduction=false

# --- SMTP --------------------------------------------------------------------
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=nao-responda@faceid.local
Smtp__UseSsl=false

# --- Integrações externas ----------------------------------------------------
BrasilApi__BaseUrl=https://brasilapi.com.br/api
BrasilApi__TimeoutSeconds=5

# --- Exportação --------------------------------------------------------------
Export__SyncRowLimit=5000
Export__RetentionDays=7

# --- Ambiente ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
